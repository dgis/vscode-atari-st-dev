{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Atari ST: make",
            "command": "make",
            "args": [],
            "problemMatcher": [
                "$vasm"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build PRG from Makefile for Atari ST."
        },
        {
            "type": "shell",
            "label": "Atari ST: make clean",
            "command": "make",
            "args": [
                "clean"
            ],
            "detail": "Cleanup from Makefile for Atari ST."
        },
        {
            "type": "shell",
            "label": "Atari ST: run",
            "command": "${config:atariSTDev.path}/hatari/hatari",
            "osx": {
                "command": "${config:atariSTDev.path}/hatari/hatari.app/Contents/MacOS/hatari"
            },
            "args": [
                "--tos", "${config:atariSTDev.path}/hatari/etos512fr.img",
                // "--tos", "${config:atariSTDev.path}/hatari/etos512us.img",
                "--confirm-quit", "no",
                // "--sound", "off",
                // "--fast-forward", "yes",
                "${workspaceFolder}${/}main.prg"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "detail": "Run PRG from active file for Atari ST.",
            "dependsOn": "Atari ST: make"
        }
    ]
}